# Copy to .env and adjust. Every variable is documented in docs/configuration.md.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgresql://folder:folder@localhost:5432/folder
# Soroban RPC endpoint (testnet). Must retain the ledgers you want to index.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Deployed Folder contract on testnet (Indexer-Contract deployments/testnet.json)
FOLDER_CONTRACT_ID=CDDQK74SMH4RB4HYLHM6BYZPTAMDMRISHW5Q274KADVZVFD57K43O6KV
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY=https://ipfs.io/ipfs

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Comma-separated origins, or * for any. Required when NODE_ENV=production.
CORS_ORIGIN=
REQUEST_BODY_LIMIT=1mb
LOG_LEVEL=info

# --- Stellar / indexer ------------------------------------------------------
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_RPC_TIMEOUT_MS=10000
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_PAGE_LIMIT=200
# First ledger to index on an empty database. The testnet contract was deployed
# at ledger 5647760; leave empty to start at the oldest ledger the RPC retains.
INDEXER_START_LEDGER=
# What to do when the saved cursor is older than the RPC retention window: halt | skip
INDEXER_ON_RETENTION_GAP=halt
INDEXER_MAX_BACKOFF_MS=60000
INDEXER_STALE_AFTER_MS=120000

# --- Database pool ----------------------------------------------------------
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# --- Portfolio transfers ----------------------------------------------------
# Feature flag for NFT ownership transfer decoding/handling. When false,
# transfer events are ignored and portfolios remain keyed by owner.
PORTFOLIO_TRANSFERS_ENABLED=false

# --- Federation (SEP-2) / stellar.toml (SEP-1) ------------------------------
# Public base URL used to build FEDERATION_SERVER in /.well-known/stellar.toml.
# Leave empty to derive from the incoming request.
FEDERATION_BASE_URL=
# Domain suffix for .folder names (e.g. folder -> name*folder).
FEDERATION_DOMAIN=folder
# Organisation info served in stellar.toml (all optional).
STELLAR_TOML_ORG_NAME=Folder
STELLAR_TOML_ORG_URL=https://folder.example
STELLAR_TOML_ORG_DESCRIPTION=
STELLAR_TOML_ORG_EMAIL=
# Cache-Control max-age (seconds) for federation and stellar.toml responses.
FEDERATION_CACHE_MAX_AGE=300

# --- Observability ----------------------------------------------------------
# Emit Server-Timing headers. In production this defaults to off unless set to true.
SERVER_TIMING=false
# Requests slower than this (ms) log a warning with the timing breakdown.
SERVER_TIMING_SLOW_THRESHOLD_MS=1000

# --- IPFS / timeouts --------------------------------------------------------
IPFS_TIMEOUT_MS=30000
HEALTHCHECK_DATABASE_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000

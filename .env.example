# Copy to .env and adjust. Every variable is documented in docs/configuration.md.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgresql://folder:folder@localhost:5432/folder
# Soroban RPC endpoint (testnet). Must retain the ledgers you want to index.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Deployed Folder contract on testnet (Indexer-Contract deployments/testnet.json)
FOLDER_CONTRACT_ID=CDDQK74SMH4RB4HYLHM6BYZPTAMDMRISHW5Q274KADVZVFD57K43O6KV
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY=https://ipfs.io/ipfs

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Comma-separated origins, or * for any. Required when NODE_ENV=production.
CORS_ORIGIN=
REQUEST_BODY_LIMIT=1mb
LOG_LEVEL=info

# --- Stellar / indexer ------------------------------------------------------
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_RPC_TIMEOUT_MS=10000
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_PAGE_LIMIT=200
# First ledger to index on an empty database. The testnet contract was deployed
# at ledger 5647760; leave empty to start at the oldest ledger the RPC retains.
INDEXER_START_LEDGER=
# What to do when the saved cursor is older than the RPC retention window: halt | skip
INDEXER_ON_RETENTION_GAP=halt
INDEXER_MAX_BACKOFF_MS=60000
INDEXER_STALE_AFTER_MS=120000

# --- Database pool ----------------------------------------------------------
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# --- IPFS / timeouts --------------------------------------------------------
IPFS_TIMEOUT_MS=30000
HEALTHCHECK_DATABASE_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000

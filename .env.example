# Copy to .env and adjust. Every variable is documented in docs/configuration.md.
# GENERATED FILE - do not edit by hand. Run `npm run docs:config` to regenerate.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgresql://folder:folder@localhost:5432/folder
# Optional: direct (non-pooled) URL for LISTEN, migrations and session locks.
# Set when DATABASE_URL points at PgBouncer in transaction mode.
# DATABASE_DIRECT_URL=postgresql://folder:folder@localhost:5432/folder
# Soroban RPC endpoint (testnet). Must retain the ledgers you want to index.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Optional: comma-separated RPC endpoints, tried in order with health-based failover.
# Takes precedence over STELLAR_RPC_URL when set.
# STELLAR_RPC_URLS=https://soroban-testnet.stellar.org,https://rpc.ankr.com/stellar_soroban
# STELLAR_RPC_FAILURE_THRESHOLD=3
# STELLAR_RPC_COOLDOWN_MS=60000
# Deployed Folder contract on testnet (Indexer-Contract deployments/testnet.json)
FOLDER_CONTRACT_ID=CDDQK74SMH4RB4HYLHM6BYZPTAMDMRISHW5Q274KADVZVFD57K43O6KV
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY=https://ipfs.io/ipfs
# Public frontend origin, used for external_url in NFT metadata.
FRONTEND_BASE_URL=http://localhost:5173

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Comma-separated origins, or * for any. Required when NODE_ENV=production.
CORS_ORIGIN=
# Express trust proxy: false (default), a hop count (e.g. 1), or comma-separated CIDRs.
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
# Minimum log level: error | warn | info | debug
LOG_LEVEL=info

# --- Stellar / indexer ------------------------------------------------------
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_RPC_TIMEOUT_MS=10000
# Extra HTTP headers for paid RPC providers, as a JSON object. Values are never logged.
# STELLAR_RPC_HEADERS={"Authorization":"Bearer <token>"}
# Or point at a JSON file with the same shape (merged over STELLAR_RPC_HEADERS).
# STELLAR_RPC_HEADERS_FILE=/run/secrets/rpc-headers.json
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_PAGE_LIMIT=200
# Max getEvents pages fetched back-to-back in one tick while catching up (1-1000)
INDEXER_MAX_PAGES_PER_TICK=50
# First ledger to index on an empty database. The testnet contract was deployed
# at ledger 5647760; leave empty to start at the oldest ledger the RPC retains.
INDEXER_START_LEDGER=
# What to do when the saved cursor is older than the RPC retention window: halt | skip
INDEXER_ON_RETENTION_GAP=halt
# Max attempts to resume when the RPC retention window moves while resuming
INDEXER_MAX_GAP_RESUME_ATTEMPTS=5
INDEXER_MAX_BACKOFF_MS=60000
# What to do when the Soroban RPC version is outside the supported range: warn | refuse
INDEXER_RPC_VERSION_POLICY=warn
INDEXER_STALE_AFTER_MS=120000
# Hard deadline for one indexer tick; on expiry the tick fails, the client is
# released and the indexer backs off. Keep it below SHUTDOWN_TIMEOUT_MS.
INDEXER_TICK_TIMEOUT_MS=30000

# --- Database pool ----------------------------------------------------------
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
# Postgres statement_timeout / idle_in_transaction_session_timeout for indexer
# connections. Keep both below INDEXER_TICK_TIMEOUT_MS.
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=20000

# --- Portfolio transfers ----------------------------------------------------
# Feature flag for NFT ownership transfer decoding/handling. When false,
# transfer events are ignored and portfolios remain keyed by owner.
PORTFOLIO_TRANSFERS_ENABLED=false

# --- Federation (SEP-2) / stellar.toml (SEP-1) ------------------------------
# Public base URL used to build FEDERATION_SERVER in /.well-known/stellar.toml.
# Leave empty to derive from the incoming request.
FEDERATION_BASE_URL=
# Domain suffix for .folder names (e.g. folder -> name*folder).
FEDERATION_DOMAIN=folder
# Organisation info served in stellar.toml (all optional).
STELLAR_TOML_ORG_NAME=Folder
STELLAR_TOML_ORG_URL=https://folder.example
STELLAR_TOML_ORG_DESCRIPTION=
STELLAR_TOML_ORG_EMAIL=
# Cache-Control max-age (seconds) for federation and stellar.toml responses.
FEDERATION_CACHE_MAX_AGE=300

# --- Observability ----------------------------------------------------------
# Emit Server-Timing headers. In production this defaults to off unless set to true.
SERVER_TIMING=false
# Requests slower than this (ms) log a warning with the timing breakdown.
SERVER_TIMING_SLOW_THRESHOLD_MS=1000

# --- IPFS / timeouts --------------------------------------------------------
IPFS_TIMEOUT_MS=30000
HEALTHCHECK_DATABASE_TIMEOUT_MS=2000
HEALTHCHECK_IPFS_TIMEOUT_MS=1000
# Reuse dependency check results for this long (avoids probe storms)
HEALTHCHECK_CACHE_MS=1000
SHUTDOWN_TIMEOUT_MS=10000

# --- Indexing latency canary (optional) -------------------------------------
# Used by scripts/canary.ts and the scheduled canary workflow. Leave unset to
# skip the canary; no secrets are required beyond the API URL.
# Base URL of the deployed API to poll for visibility of the canary action.
# CANARY_API_URL=http://localhost:3000
# Maximum acceptable end-to-end latency (submit -> ledger close -> API visible).
# CANARY_THRESHOLD_MS=120000
# How often to poll the API while waiting for the change to appear.
# CANARY_POLL_INTERVAL_MS=5000
# Overall timeout for a single canary run.
# CANARY_TIMEOUT_MS=180000
# Set to 1 to simulate the run without funding an account or submitting a tx.
# CANARY_DRY_RUN=0

{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "testMatch": ["**/__tests__/**/*.test.ts"],
  "testPathIgnorePatterns": ["/node_modules/", "/dist/"],
  "modulePathIgnorePatterns": ["<rootDir>/dist/"],
  "moduleFileExtensions": ["ts", "js"],
  "setupFiles": ["<rootDir>/src/__tests__/jest.env.ts"]
}
